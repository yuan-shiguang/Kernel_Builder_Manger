{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kernel Builder Manager",
  "version": "0.1.0",
  "identifier": "moe.yukina.kernelbuildermanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kernel Builder Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://*.github.com https://*.githubusercontent.com https://*.googlesource.com"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "category": "DevelopmentTool",
    "shortDescription": "Android 内核构建管理器",
    "longDescription": "基于 Tauri 2.0 / Vue 3 / WinUIonWeb 的 Android 内核构建、补丁与工具链管理器"
  },
  "plugins": {}
}
